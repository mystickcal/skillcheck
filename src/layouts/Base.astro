---
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";
import { repoUrl } from "../lib/links";
import { shareImageDescription, shareImageUrl } from "../lib/share";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = shareImageUrl(Astro.site ?? canonical.origin, import.meta.env.BASE_URL);
const imageAlt = `SkillCheck. ${shareImageDescription}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={import.meta.env.BASE_URL}>SkillCheck</a>
      <nav>
        <a href={import.meta.env.BASE_URL}>Index</a>
        <a href={`${import.meta.env.BASE_URL}best/`}>Best skills</a>
        <a href={`${import.meta.env.BASE_URL}about/`}>About</a>
        <a href={repoUrl}>GitHub</a>
      </nav>
    </header>
    <main id="content" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <p>SkillCheck stores metadata and links. It does not host skill files.</p>
    </footer>
    <Analytics />
  </body>
</html>
